{
  "name": "evanbaker-site",
  "version": "0.1.0",
  "private": true,
  "description": "Personal website for Evan Baker. Next.js App Router, static export to GitHub Pages.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "serve out --listen 4321 --no-clipboard",
    "build:pages": "NEXT_PUBLIC_BASE_PATH=/personalWebsite next build"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "marked": "18.0.12"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "serve": "14.2.6",
    "typescript": "5.9.3"
  }
}
